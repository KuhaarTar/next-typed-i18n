{
  "name": "next-typed-i18n",
  "version": "0.1.6",
  "description": "Type-safe, zero-config i18n for Next.js App Router with automatic locale detection, server/client dictionary loading, and middleware.",
  "keywords": [
    "next.js",
    "i18n",
    "internationalization",
    "typescript",
    "app-router",
    "type-safe"
  ],
  "author": "Taras Kukhar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KuhaarTar/next-typed-i18n.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/client.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
